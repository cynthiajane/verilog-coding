module reg_8bit_tb();
  reg [7:0] d;
  reg clk;
  wire q;
  
  reg_8bit dut (.d(d), .clk(clk), .q(q));
  
  initial begin 
    $display("reg_8bit");
    $monitor("t=0%t, d=%b clk=%b | q=%b", $time, d,clk,q);
  end 
  
  initial begin 
    $dumpvars;
    $dumpfile("reg_8bit.vcd");
  end 
  
  initial begin 
    clk=0;
    forever #5 clk=~clk;
  end 
  initial begin 
    d=8'b00000000;#10;
    d=8'b00101000;#10;  
    d=8'b00001011;#10;
    d=8'b00001111;#10;
    $finish;
  end 
endmodule 